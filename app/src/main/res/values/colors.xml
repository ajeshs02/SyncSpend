<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the pre-Compose starting-window background lives here — everything
  else (the real color scheme, gradients, tokens) is Kotlin in ui/theme/Color.kt,
  since a plain XML theme can't paint a gradient. This is a flat approximation
  of the design's screen-gradient midtone, visible for a frame or two on cold
  start before Compose's first frame lands.
-->
<resources>
    <color name="window_background">#FFFAFAFA</color>

    <!--
      Home-screen widget colours. The widget does not paint its own gradient: it
      takes a plain surface that follows the system light/dark setting (and, on
      Android 12+, the wallpaper-derived Material You neutral — see values-v31).
      True neutral grays, matching the app's monochrome base; only widget_fab
      carries the gold accent.
    -->
    <color name="widget_surface">#FFF7F7F8</color>
    <color name="widget_ink">#FF141416</color>
    <color name="widget_sub">#FF6C7075</color>
    <color name="widget_neg">#FFC0392B</color>
    <color name="widget_fab">#FFD1ECCF</color>
    <color name="widget_on_fab">#FF1A1A1A</color>
    <color name="widget_ripple">#1F141416</color>
</resources>
