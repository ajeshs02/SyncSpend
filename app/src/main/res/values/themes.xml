<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Controls only the window before Compose takes over. All real theming
      (colors, light/dark/system, typography) lives in ui/theme/Theme.kt.
    -->
    <style name="Theme.SyncSpend" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Platform date/time picker dialogs, tinted to the app's accent. The
         in-app Light/Dark choice is independent of the system setting, so the
         picker theme is chosen at show time rather than following night mode. -->
    <style name="Theme.SyncSpend.PickerLight" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">#2F7A45</item>
        <item name="android:colorControlActivated">#2F7A45</item>
        <item name="android:textColorPrimary">#151A12</item>
        <item name="android:windowBackground">@drawable/picker_bg_light</item>
    </style>

    <style name="Theme.SyncSpend.PickerDark" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">#7FD39A</item>
        <item name="android:colorControlActivated">#7FD39A</item>
        <item name="android:textColorPrimary">#EEF3EA</item>
        <item name="android:windowBackground">@drawable/picker_bg_dark</item>
    </style>
</resources>
