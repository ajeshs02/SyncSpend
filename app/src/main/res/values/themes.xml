<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Controls only the window before Compose takes over. All real theming
      (colors, light/dark/system, typography) lives in ui/theme/Theme.kt.
    -->
    <style name="Theme.SyncSpend" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Cold-start splash (androidx core-splashscreen): the day/night window colour with the
         app glyph, shown until the first real data is loaded, then the normal app theme. -->
    <style name="Theme.SyncSpend.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SyncSpend</item>
    </style>

    <!-- The widget's quick-add overlay. Translucent so the home screen stays
         visible behind the panel; window animations are cleared because the
         panel animates itself (a system transition on top reads as a stutter). -->
    <style name="Theme.SyncSpend.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
