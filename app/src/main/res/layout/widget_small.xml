<?xml version="1.0" encoding="utf-8"?>
<!-- Smallest size: the amount, centered, with a small round "+" badge back in the corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ripple"
    android:contentDescription="@string/widget_click_description"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/cabin_variable"
        android:fontVariationSettings="'wght' 600"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="15sp" />

    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/widget_fab_bg">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_plus" />
    </FrameLayout>
</FrameLayout>
