<?xml version="1.0" encoding="utf-8"?>
<!-- Wider sizes: glyph + "Expense +" label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ripple"
    android:contentDescription="@string/widget_click_description"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="16dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_coin" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:fontFamily="@font/archivo_semibold"
        android:maxLines="1"
        android:text="@string/widget_face_label"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />
</LinearLayout>
